# ==============================================================================
# Investiga Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.development and customize for your environment.
# In production, provide these values via secure secrets manager (e.g., Vault, AWS Secrets Manager).

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP__NAME=Investiga
APP__TAGLINE="AI-Powered Incident Investigation Platform"
APP__VERSION=0.1.0
APP__ENVIRONMENT=development
APP__DEBUG=true
APP__API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__WORKERS=1
SERVER__RELOAD=true

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: openssl rand -hex 32
SECURITY__SECRET_KEY=change-me-in-production-09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database Configuration (Strictly Asynchronous)
# ------------------------------------------------------------------------------
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investiga_db
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__ECHO_SQL=false

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOGGING__LOG_LEVEL=INFO
LOGGING__JSON_LOGS=false

# ------------------------------------------------------------------------------
# CORS Policies
# ------------------------------------------------------------------------------
CORS__ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]
