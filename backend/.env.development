# ==============================================================================
# Investiga Backend Local Development Environment (.env.development)
# ==============================================================================
APP_ENV=development

APP__NAME=Investiga
APP__TAGLINE="AI-Powered Incident Investigation Platform"
APP__VERSION=0.1.0
APP__ENVIRONMENT=development
APP__DEBUG=true
APP__API_V1_PREFIX=/api/v1

SERVER__HOST=127.0.0.1
SERVER__PORT=8000
SERVER__WORKERS=1
SERVER__RELOAD=true

SECURITY__SECRET_KEY=dev-secret-key-for-local-development-investiga-platform-key-09d25e094faa
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investiga_dev
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=15
DATABASE__POOL_RECYCLE=1800
DATABASE__ECHO_SQL=false

LOGGING__LOG_LEVEL=DEBUG
LOGGING__JSON_LOGS=false

CORS__ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]
