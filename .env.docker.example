# ==============================================================================
# Investiga – Docker Environment Template (.env.docker.example)
# ==============================================================================
# Copy this file to .env.docker BEFORE running docker compose:
#
#   cp .env.docker.example .env.docker
#
# NEVER commit .env.docker to version control.
# All nested settings use the __ delimiter defined in Settings (pydantic-settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL credentials (used by both the postgres service and DATABASE__URL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investiga_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Qdrant ports (host-side bindings)
# ------------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# Backend port (host-side binding)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Application Configuration
# Note: DATABASE__URL and VECTORSTORE__HOST are automatically overridden
# by docker-compose.yml to use compose service names (postgres / qdrant).
# You do NOT need to change those here.
# ------------------------------------------------------------------------------
APP__NAME=Investiga
APP__TAGLINE="AI-Powered Incident Investigation Platform"
APP__VERSION=0.1.0
APP__ENVIRONMENT=production
APP__DEBUG=false
APP__API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Server Configuration
# SERVER__HOST and SERVER__PORT are overridden in docker-compose.yml.
# ------------------------------------------------------------------------------
SERVER__WORKERS=2
SERVER__RELOAD=false

# ------------------------------------------------------------------------------
# Security – CHANGE THESE BEFORE DEPLOYING
# Generate a strong key: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECURITY__SECRET_KEY=change-me-in-production-replace-with-openssl-rand-hex-32-output
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database Connection Pool
# ------------------------------------------------------------------------------
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__ECHO_SQL=false

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOGGING__LOG_LEVEL=INFO
LOGGING__JSON_LOGS=true

# ------------------------------------------------------------------------------
# CORS – update with your frontend origin(s)
# ------------------------------------------------------------------------------
CORS__ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]

# ------------------------------------------------------------------------------
# Vector Store (Qdrant)
# VECTORSTORE__HOST is overridden in docker-compose.yml to "qdrant".
# ------------------------------------------------------------------------------
VECTORSTORE__PORT=6333
VECTORSTORE__GRPC_PORT=6334
VECTORSTORE__PREFER_GRPC=true
VECTORSTORE__COLLECTION_NAME=investiga_knowledge

# ------------------------------------------------------------------------------
# RAG / LLM Providers
# ------------------------------------------------------------------------------
RAG__LLM_PROVIDER=gemini
RAG__GEMINI_API_KEY=your-google-gemini-api-key-here
RAG__GEMINI_MODEL=gemini-1.5-flash

# Uncomment to use Ollama (requires ollama service – future phase)
# RAG__LLM_PROVIDER=ollama
# RAG__OLLAMA_BASE_URL=http://ollama:11434
# RAG__OLLAMA_MODEL=llama3
